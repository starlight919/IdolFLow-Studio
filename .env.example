# ═══════════════════════════════════════════════════
#  idol-video-studio 环境配置
#  复制为 .env 后填写真实值。.env 已在 .gitignore，不会被提交。
# ═══════════════════════════════════════════════════

# Seedance API 网关地址（必填，从公司内部获取，勿公开）
SEEDANCE_API_BASE=https://<your-internal-gateway>/phanrouter

# Seedance SD2.0 API Key（必填）
SEEDANCE_API_KEY=

# Seedance SD2.5 API Key（若用到 2.5 模型则必填）
SEEDANCE_SD25_API_KEY=

# Seedance 素材分组 ID（必填，用于 CreateAsset）
ASSET_GROUP_ID=

# Pinggy 隧道 Token（素材上传给 Seedance 时自动按需启动隧道）
PINGGY_TOKEN=

# Ngrok 隧道 Token（备用，一般不需要）
NGROK_AUTHTOKEN=

# 提交确认密码（防误触/防他人乱点消耗 API 额度）
# 用 scripts/gen_password.py <密码> 生成 SECRET 和 HASH，填入下面两项。
# .env 里不存明文密码，只存盐+哈希，即使泄露也无法反推密码。
VIDEO_SUBMIT_SECRET=
VIDEO_SUBMIT_HASH=
